class Solution:
    def longestOnes(self, nums: List[int], k: int) -> int:
        n=len(nums)
        left,right=0,0
        maxLen=0
        zeroes=0
        while(right<n):
            if(nums[right]==0):
                zeroes+=1
            while(zeroes>k):
                if(nums[left] == 0):
                    zeroes-=1
                left+=1
            maxLen=max(maxLen,right-left+1)
            right+=1
        return maxLen
